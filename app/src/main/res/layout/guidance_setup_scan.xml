<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="40dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/guidance_breadcrumb"
        style="@style/Widget.Leanback.GuidanceBreadcrumbStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9AA6B8" />

    <TextView
        android:id="@+id/guidance_title"
        style="@style/Widget.Leanback.GuidanceTitleStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/guidance_description"
        style="@style/Widget.Leanback.GuidanceDescriptionStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#C8D3E3" />

    <TextView
        android:id="@+id/sync_status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#7AB0FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channel_logo_preview_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:paddingBottom="12dp" />

</LinearLayout>
